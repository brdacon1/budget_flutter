<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Necessário para o APNs entregar push no iOS. Ambiente 'development'
	     para builds de debug (rodando direto no device/sim com provisioning
	     de desenvolvimento). Build de release usa RunnerRelease.entitlements
	     com 'production'. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
