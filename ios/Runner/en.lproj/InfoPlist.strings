/* Permission messages (English) */
"NSCameraUsageDescription" = "The camera is used to take photos of your company logo and payment receipts. For example: you photograph a payment receipt and it is saved in the customer quote.";
"NSContactsUsageDescription" = "Your contacts are used to fill in the customer details when creating a quote and, if you choose, to save a new customer to your address book. For example: when you pick \"Maria\" from your list, her name and phone number are filled in on the quote automatically.";
"NSPhotoLibraryUsageDescription" = "Your photos are used to choose your company logo and attach payment receipts to quotes. For example: you select a payment screenshot and it is saved in the customer quote.";
