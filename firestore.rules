rules_version = '2';

// PROPOSTA — ainda NÃO está ligada ao firebase.json.
// Antes de publicar, compare com as regras atuais no Console
// (Firestore Database → Regras) e teste no Rules Playground / emulador.
//
// Princípio: cada usuário só acessa os próprios dados. O fluxo Web público
// não acessa o Firestore direto — passa pelas Cloud Functions de share link
// (Admin SDK ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    // Dados do dono: EMPRESAS/{uid}/... (orçamentos, itens, recibos, FCM,
    // notificações, INFOPDF, COMENTARIOS etc.).
    match /EMPRESAS/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /EMPRESAS/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Perfil: doc id = uid; o app também consulta `where USER == uid`.
    match /USUARIOS/{uid} {
      allow get, create, update, delete:
        if request.auth != null && request.auth.uid == uid;
      allow list:
        if request.auth != null && resource.data.USER == request.auth.uid;
    }

    // Links públicos de orçamento: só as Cloud Functions acessam.
    match /SHARE_LINKS/{code} {
      allow read, write: if false;
    }

    // Todo o resto: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
